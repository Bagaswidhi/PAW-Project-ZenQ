<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <!-- Tailwind CSS via CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen font-sans flex flex-col justify-between">

    <!-- Navbar -->
    <nav class="bg-slate-800/80 backdrop-blur border-b border-slate-700 sticky top-0 z-50 px-6 py-4 flex justify-between items-center">
        <a href="/" class="text-xl font-bold text-cyan-400">ZenQ Store</a>
        <div class="flex space-x-6 text-sm font-medium">
            <a href="/" class="text-slate-300 hover:text-cyan-400 transition">Beranda</a>
            <a href="/api/status" target="_blank" class="text-slate-300 hover:text-cyan-400 transition">API Status</a>
            <a href="/api/produk" target="_blank" class="text-slate-300 hover:text-cyan-400 transition">API Produk</a>
            <a href="/api/produk/<%= product.id %>" target="_blank" class="text-cyan-400 hover:text-cyan-300 transition">API Produk Ini</a>
        </div>
    </nav>

    <!-- Main Detail Section -->
    <main class="max-w-4xl mx-auto px-6 py-10 flex-grow w-full">
        <!-- Back Button -->
        <a href="/" class="inline-flex items-center text-sm font-semibold text-cyan-400 hover:text-cyan-300 mb-6 transition">
            ← Kembali ke Katalog
        </a>

        <div class="bg-slate-800/70 border border-slate-700 rounded-2xl p-6 md:p-8 shadow-xl">
            <!-- Header Info -->
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-6 border-b border-slate-700/60">
                <div>
                    <span class="text-xs font-semibold text-cyan-400 bg-cyan-950 px-3 py-1 rounded-full border border-cyan-800/50">
                        <%= product.kategori %>
                    </span>
                    <h1 class="text-2xl md:text-3xl font-extrabold text-white mt-2">
                        <%= product.nama %>
                    </h1>
                    <div class="flex items-center gap-4 text-sm text-slate-400 mt-2">
                        <span>⭐ <%= product.rating %> (<%= product.terjual %>+ Terjual)</span>
                        <span>•</span>
                        <span class="text-emerald-400 font-medium">Stok Tersedia: <%= product.stok %> unit</span>
                    </div>
                </div>
                <div class="text-left md:text-right">
                    <span class="text-xs text-slate-400 block">Harga</span>
                    <span class="text-2xl md:text-3xl font-extrabold text-cyan-400">
                        Rp <%= product.harga.toLocaleString('id-ID') %>
                    </span>
                </div>
            </div>

            <!-- Specifications Grid -->
            <div class="py-6">
                <h2 class="text-lg font-bold text-white mb-4 border-l-4 border-cyan-400 pl-3">Spesifikasi Utama</h2>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                    <div class="bg-slate-900/60 p-4 rounded-xl border border-slate-700/50">
                        <span class="text-xs text-slate-400">Prosesor</span>
                        <p class="font-bold text-white mt-1"><%= product.prosesor %></p>
                    </div>
                    <div class="bg-slate-900/60 p-4 rounded-xl border border-slate-700/50">
                        <span class="text-xs text-slate-400">RAM</span>
                        <p class="font-bold text-white mt-1"><%= product.ram %></p>
                    </div>
                    <div class="bg-slate-900/60 p-4 rounded-xl border border-slate-700/50">
                        <span class="text-xs text-slate-400">Penyimpanan</span>
                        <p class="font-bold text-white mt-1"><%= product.storage %></p>
                    </div>
                </div>
            </div>

            <!-- Description -->
            <div class="py-4 border-t border-slate-700/60">
                <h2 class="text-lg font-bold text-white mb-2">Deskripsi Produk</h2>
                <p class="text-slate-300 leading-relaxed">
                    <%= product.deskripsi %>
                </p>
            </div>

            <!-- Action Buttons -->
            <div class="pt-6 border-t border-slate-700/60 flex flex-col sm:flex-row gap-3">
                <a href="/" class="w-full sm:w-auto text-center px-6 py-2.5 bg-slate-700 hover:bg-slate-600 text-slate-200 font-semibold rounded-lg text-sm transition">
                    ← Kembali ke Katalog
                </a>
                <a href="/api/produk/<%= product.id %>" target="_blank" class="w-full sm:w-auto text-center px-6 py-2.5 bg-cyan-500 hover:bg-cyan-600 text-slate-950 font-bold rounded-lg text-sm transition">
                    Lihat Data JSON (API)
                </a>
            </div>
        </div>
    </main>

    <!-- Footer -->
    <footer class="bg-slate-800/50 border-t border-slate-700/50 py-6 text-center text-slate-400 text-sm">
        <p>&copy; 2026 ZenQ Store — Tugas Praktikum PPAW Week 7 (MVC, REST API & Logger)</p>
    </footer>

</body>
</html>

