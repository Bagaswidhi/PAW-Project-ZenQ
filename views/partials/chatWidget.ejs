<!-- FLOATING ZENQ AI CHATBOT WIDGET COMPONENT (PARTIAL) -->
<div id="aiChatWrapper" class="fixed bottom-6 right-6 z-50 flex flex-col items-end">
    <!-- Box Chat -->
    <div id="aiChatBox" class="hidden mb-3 w-[calc(100vw-2rem)] sm:w-96 h-[560px] max-h-[84vh] bg-slate-900/95 border border-cyan-500/40 rounded-2xl shadow-2xl backdrop-blur-xl flex flex-col overflow-hidden transition-all duration-300">
        <!-- Header Chat -->
        <div class="bg-gradient-to-r from-slate-900 via-slate-800 to-slate-900 border-b border-slate-700/80 p-3.5 flex items-center justify-between">
            <div class="flex items-center gap-2.5">
                <div class="relative w-9 h-9 rounded-full bg-cyan-500/20 border border-cyan-400/50 flex items-center justify-center text-lg">
                    🤖
                    <span class="absolute bottom-0 right-0 w-2.5 h-2.5 bg-emerald-400 border-2 border-slate-900 rounded-full"></span>
                </div>
                <div>
                    <h4 class="font-bold text-sm text-white">ZenQ AI Assistant</h4>
                    <p class="text-[11px] text-cyan-400 flex items-center gap-1">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span> Online • Rekomendasi Laptop
                    </p>
                </div>
            </div>
            <div class="flex items-center gap-1">
                <button type="button" onclick="resetChatSession()" class="text-[11px] text-slate-400 hover:text-cyan-400 px-2 py-1 rounded-lg transition" title="Mulai Obrolan Baru">
                    Reset
                </button>
                <button type="button" onclick="toggleChat()" class="text-slate-400 hover:text-white p-1.5 rounded-lg text-sm font-bold" title="Tutup Chat">
                    ✕
                </button>
            </div>
        </div>

        <!-- Area Pesan -->
        <div id="aiChatMessages" class="flex-1 p-4 overflow-y-auto space-y-3 text-xs leading-relaxed">
            <div class="flex items-start gap-2.5">
                <div class="w-7 h-7 rounded-full bg-cyan-500/20 border border-cyan-400/50 flex items-center justify-center text-xs shrink-0 mt-0.5">🤖</div>
                <div class="bg-slate-800/70 border border-slate-700/60 text-slate-200 p-3 rounded-2xl rounded-tl-none max-w-[85%] space-y-2">
                    <p>Halo! 👋 Tanyakan apapun tentang spesifikasi, stok, atau rekomendasi laptop sesuai budget di ZenQ Store.</p>
                </div>
            </div>

            <!-- Pintasan Pertanyaan -->
            <div id="quickPrompts" class="flex flex-wrap gap-1.5 pl-9">
                <button type="button" onclick="sendQuickPrompt('Rekomendasi laptop kuliah budget 7 jutaan')" class="text-[11px] bg-cyan-950/80 hover:bg-cyan-900 text-cyan-300 border border-cyan-800/60 px-2.5 py-1 rounded-full transition">
                    💻 Laptop kuliah 7 jutaan
                </button>
                <button type="button" onclick="sendQuickPrompt('Apa bedanya RAM dan SSD?')" class="text-[11px] bg-cyan-950/80 hover:bg-cyan-900 text-cyan-300 border border-cyan-800/60 px-2.5 py-1 rounded-full transition">
                    🧠 Beda RAM & SSD
                </button>
                <button type="button" onclick="sendQuickPrompt('Cek stok ASUS Vivobook Go 14')" class="text-[11px] bg-cyan-950/80 hover:bg-cyan-900 text-cyan-300 border border-cyan-800/60 px-2.5 py-1 rounded-full transition">
                    📦 Cek stok produk
                </button>
            </div>
        </div>

        <!-- Bar Rating Kepuasan Pengguna (CSAT) -->
        <div id="csatBar" class="hidden px-3.5 py-2 bg-slate-800/80 border-t border-slate-700/70 flex items-center justify-between text-[11px] text-slate-300">
            <span id="csatPromptText">Apakah jawaban ZenQ AI membantu?</span>
            <div id="csatButtons" class="flex items-center gap-1.5">
                <button type="button" onclick="submitCSAT('up')" class="bg-slate-700 hover:bg-emerald-600/30 hover:border-emerald-500 border border-slate-600 px-2.5 py-1 rounded-lg transition" title="Puas">
                    👍 Ya
                </button>
                <button type="button" onclick="submitCSAT('down')" class="bg-slate-700 hover:bg-rose-600/30 hover:border-rose-500 border border-slate-600 px-2.5 py-1 rounded-lg transition" title="Kurang Puas">
                    👎 Tidak
                </button>
            </div>
        </div>

        <!-- Form Input Chat -->
        <form id="aiChatForm" onsubmit="handleSendChat(event)" class="p-3 bg-slate-900/90 border-t border-slate-700/80 flex gap-2 items-center">
            <input type="text" id="aiChatInput" maxlength="500" placeholder="Tanyakan seputar laptop ZenQ..." autocomplete="off" required class="flex-1 bg-slate-800 border border-slate-700 text-white text-xs rounded-xl px-3.5 py-2.5 focus:border-cyan-400 focus:outline-none">
            <button type="submit" id="aiChatSubmitBtn" class="bg-cyan-500 hover:bg-cyan-400 disabled:opacity-50 text-slate-950 font-bold px-4 py-2.5 rounded-xl text-xs transition flex items-center justify-center shrink-0">
                Kirim
            </button>
        </form>
    </div>

    <!-- Tombol Pemicu Floating Action Button -->
    <button type="button" id="aiChatToggleBtn" onclick="toggleChat()" class="group relative flex items-center gap-2.5 bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-slate-950 font-bold px-4 py-3 rounded-full shadow-xl shadow-cyan-500/25 transition-all transform hover:scale-105 active:scale-95">
        <span class="text-xl">🤖</span>
        <span class="text-xs font-extrabold tracking-wide text-slate-950 hidden sm:inline">Tanya ZenQ AI</span>
    </button>
</div>

<!-- Script Logika Chatbot (Multi-Turn, Kartu Produk, Eskalasi Admin & CSAT) -->
<script>
    const aiChatBox = document.getElementById('aiChatBox');
    const aiChatMessages = document.getElementById('aiChatMessages');
    const aiChatInput = document.getElementById('aiChatInput');
    const aiChatSubmitBtn = document.getElementById('aiChatSubmitBtn');
    const quickPrompts = document.getElementById('quickPrompts');
    const csatBar = document.getElementById('csatBar');

    // State percakapan sesi
    let chatHistory = [];
    let consecutiveFailures = 0;
    let csatSubmitted = false;

    function toggleChat() {
        aiChatBox.classList.toggle('hidden');
        if (!aiChatBox.classList.contains('hidden')) {
            setTimeout(() => aiChatInput.focus(), 150);
        }
    }

    function resetChatSession() {
        chatHistory = [];
        consecutiveFailures = 0;
        csatSubmitted = false;
        if (csatBar) csatBar.classList.add('hidden');
        const promptEl = document.getElementById('csatPromptText');
        if (promptEl) promptEl.textContent = 'Apakah jawaban ZenQ AI membantu?';
        const btnsEl = document.getElementById('csatButtons');
        if (btnsEl) btnsEl.classList.remove('hidden');

        aiChatMessages.innerHTML = `
            <div class="flex items-start gap-2.5">
                <div class="w-7 h-7 rounded-full bg-cyan-500/20 border border-cyan-400/50 flex items-center justify-center text-xs shrink-0 mt-0.5">🤖</div>
                <div class="bg-slate-800/70 border border-slate-700/60 text-slate-200 p-3 rounded-2xl rounded-tl-none max-w-[85%] space-y-2">
                    <p>Sesi baru dimulai! 👋 Tanyakan spesifikasi, stok, atau rekomendasi laptop di ZenQ Store.</p>
                </div>
            </div>
        `;
    }

    function sendQuickPrompt(text) {
        if (aiChatInput.disabled) return;
        aiChatInput.value = text;
        document.getElementById('aiChatForm').dispatchEvent(new Event('submit', { cancelable: true }));
    }

    function askAboutThisProduct(productName) {
        if (aiChatBox.classList.contains('hidden')) {
            toggleChat();
        }
        aiChatInput.value = `Jelaskan kelebihan dan spesifikasi lengkap laptop ${productName}`;
        document.getElementById('aiChatForm').dispatchEvent(new Event('submit', { cancelable: true }));
    }

    function submitCSAT(vote) {
        if (csatSubmitted) return;
        csatSubmitted = true;
        const label = vote === 'up' ? 'Terima kasih atas rating positif (👍) Anda!' : 'Terima kasih atas masukannya (👎), akan kami tingkatkan.';
        document.getElementById('csatPromptText').textContent = label;
        document.getElementById('csatButtons').classList.add('hidden');
    }

    function escapeHTML(str) {
        return String(str)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;');
    }

    function formatMarkdown(text) {
        let html = escapeHTML(text);
        html = html.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
        html = html.replace(/^\*\s+(.+)$/gm, '<div class="flex items-start gap-1.5 my-0.5"><span class="text-cyan-400">•</span><span>$1</span></div>');
        html = html.replace(/\n/g, '<br>');
        return html;
    }

    function renderProductCards(products) {
        if (!Array.isArray(products) || products.length === 0) return '';

        const cardsHTML = products.slice(0, 3).map((p) => {
            const stokCount = Number(p.stok) || 0;
            const stokBadge = stokCount > 0
                ? `<span class="text-[10px] font-semibold text-emerald-400 bg-emerald-950/80 border border-emerald-700/50 px-2 py-0.5 rounded-full">Tersedia (${stokCount})</span>`
                : `<span class="text-[10px] font-semibold text-rose-400 bg-rose-950/80 border border-rose-700/50 px-2 py-0.5 rounded-full">Habis</span>`;

            return `
                <div class="bg-slate-900/90 border border-slate-700/80 hover:border-cyan-500/60 rounded-xl p-3 space-y-2 transition shadow">
                    <div class="flex items-start justify-between gap-2">
                        <div>
                            <span class="text-[10px] font-semibold text-cyan-400 uppercase tracking-wider">${escapeHTML(p.kategori)}</span>
                            <h5 class="font-bold text-xs text-white leading-snug">${escapeHTML(p.nama)}</h5>
                        </div>
                        ${stokBadge}
                    </div>
                    <p class="text-[11px] text-slate-400">
                        ${escapeHTML(p.prosesor)} • ${escapeHTML(p.ram)} • ${escapeHTML(p.storage)}
                    </p>
                    <div class="flex items-center justify-between pt-1 border-t border-slate-800">
                        <span class="text-xs font-extrabold text-cyan-400">
                            Rp ${Number(p.harga).toLocaleString('id-ID')}
                        </span>
                        <a href="/produk/${encodeURIComponent(p.id)}" class="bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-bold text-[11px] px-3 py-1.5 rounded-lg transition">
                            Lihat Detail →
                        </a>
                    </div>
                </div>
            `;
        }).join('');

        return `<div class="space-y-2 pt-1">${cardsHTML}</div>`;
    }

    // Kartu eskalasi admin setelah 2x berturut-turut gagal memahami konteks
    function appendEscalationCard() {
        const formId = 'escForm_' + Date.now();
        const waText = encodeURIComponent('Halo Admin ZenQ Store, saya membutuhkan bantuan konsultasi laptop.');
        const wrapper = document.createElement('div');
        wrapper.className = 'flex items-start gap-2.5';
        wrapper.innerHTML = `
            <div class="w-7 h-7 rounded-full bg-amber-500/20 border border-amber-400/50 flex items-center justify-center text-xs shrink-0 mt-0.5">🎧</div>
            <div class="max-w-[88%] bg-amber-950/40 border border-amber-500/40 text-slate-200 p-3 rounded-2xl rounded-tl-none space-y-2.5 shadow-md">
                <p class="text-amber-200 font-semibold">Mohon maaf, sepertinya asisten AI belum dapat menjawab pertanyaan Anda dengan tepat.</p>
                <p class="text-[11px] text-slate-300">Silakan terhubung langsung dengan admin kami atau tinggalkan kontak untuk ditindaklanjuti:</p>
                <div class="flex flex-col gap-1.5">
                    <a href="https://wa.me/6281234567890?text=${waText}" target="_blank" rel="noopener" class="w-full text-center bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold py-2 px-3 rounded-xl text-[11px] transition">
                        💬 Hubungi Layanan Pelanggan
                    </a>
                    <button type="button" onclick="document.getElementById('${formId}').classList.toggle('hidden')" class="w-full text-center bg-slate-800 hover:bg-slate-700 text-cyan-300 border border-slate-700 font-semibold py-1.5 px-3 rounded-xl text-[11px] transition">
                        📋 Tinggalkan Kontak Tindak Lanjut
                    </button>
                </div>
                <form id="${formId}" onsubmit="handleEscalationContact(event, '${formId}')" class="hidden space-y-2 pt-2 border-t border-amber-500/20">
                    <input type="text" name="contactName" placeholder="Nama Anda" required class="w-full bg-slate-900 border border-slate-700 rounded-lg px-2.5 py-1.5 text-[11px] text-white focus:border-cyan-400 focus:outline-none">
                    <input type="email" name="contactEmail" placeholder="Email / WhatsApp Anda" required class="w-full bg-slate-900 border border-slate-700 rounded-lg px-2.5 py-1.5 text-[11px] text-white focus:border-cyan-400 focus:outline-none">
                    <label class="flex items-start gap-1.5 text-[10px] text-slate-400 cursor-pointer">
                        <input type="checkbox" required class="mt-0.5 accent-cyan-500">
                        <span>Saya setuju data kontak ini digunakan admin ZenQ Store untuk tindak lanjut pertanyaan.</span>
                    </label>
                    <button type="submit" class="w-full bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-bold py-1.5 rounded-lg text-[11px] transition">
                        Kirim ke Admin
                    </button>
                </form>
            </div>
        `;
        aiChatMessages.appendChild(wrapper);
        aiChatMessages.scrollTop = aiChatMessages.scrollHeight;
    }

    function handleEscalationContact(e, formId) {
        e.preventDefault();
        const form = document.getElementById(formId);
        const name = form.contactName.value.trim();
        form.innerHTML = `<p class="text-[11px] text-emerald-400 font-semibold">✅ Terima kasih ${escapeHTML(name)}, permintaan Anda telah diteruskan ke admin ZenQ Store.</p>`;
    }

    async function handleSendChat(e) {
        e.preventDefault();
        const message = aiChatInput.value.trim();
        if (!message) return;

        if (quickPrompts) {
            quickPrompts.classList.add('hidden');
        }

        appendUserMessage(message);
        aiChatInput.value = '';
        aiChatInput.disabled = true;
        aiChatSubmitBtn.disabled = true;

        const typingIndicator = appendTypingIndicator();

        try {
            const res = await fetch('/api/chat', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    message,
                    history: chatHistory
                })
            });

            const result = await res.json();
            typingIndicator.remove();

            if (res.ok && result.success && result.data && result.data.reply) {
                const replyText = result.data.reply;
                const products = result.data.products || [];
                const isUnrecognized = Boolean(result.data.isUnrecognized);

                // Simpan ke riwayat sesi untuk percakapan multi-turn
                chatHistory.push({ role: 'user', text: message });
                chatHistory.push({ role: 'model', text: replyText });
                if (chatHistory.length > 6) {
                    chatHistory = chatHistory.slice(-6);
                }

                appendBotMessage(replyText, products);

                if (!csatSubmitted && csatBar) {
                    csatBar.classList.remove('hidden');
                }

                // Cek kegagalan memahami konteks 2x berturut-turut untuk eskalasi
                if (isUnrecognized) {
                    consecutiveFailures++;
                    if (consecutiveFailures >= 2) {
                        appendEscalationCard();
                        consecutiveFailures = 0;
                    }
                } else {
                    consecutiveFailures = 0;
                }
            } else {
                const errMsg = (result && result.message) ? result.message : 'Maaf, gagal mendapatkan respons dari asisten AI.';
                appendBotMessage(`⚠️ ${errMsg}`);
                consecutiveFailures++;
                if (consecutiveFailures >= 2) {
                    appendEscalationCard();
                    consecutiveFailures = 0;
                }
            }
        } catch (err) {
            typingIndicator.remove();
            appendBotMessage('⚠️ Terjadi gangguan koneksi ke server chatbot.');
            consecutiveFailures++;
            if (consecutiveFailures >= 2) {
                appendEscalationCard();
                consecutiveFailures = 0;
            }
        } finally {
            aiChatInput.disabled = false;
            aiChatSubmitBtn.disabled = false;
            aiChatInput.focus();
            aiChatMessages.scrollTop = aiChatMessages.scrollHeight;
        }
    }

    function appendUserMessage(text) {
        const wrapper = document.createElement('div');
        wrapper.className = 'flex justify-end';
        wrapper.innerHTML = `
            <div class="bg-gradient-to-r from-cyan-600 to-blue-600 text-white p-3 rounded-2xl rounded-tr-none max-w-[85%] shadow-md">
                ${formatMarkdown(text)}
            </div>
        `;
        aiChatMessages.appendChild(wrapper);
        aiChatMessages.scrollTop = aiChatMessages.scrollHeight;
    }

    function appendBotMessage(text, products = []) {
        const wrapper = document.createElement('div');
        wrapper.className = 'flex items-start gap-2.5';
        wrapper.innerHTML = `
            <div class="w-7 h-7 rounded-full bg-cyan-500/20 border border-cyan-400/50 flex items-center justify-center text-xs shrink-0 mt-0.5">🤖</div>
            <div class="max-w-[88%] space-y-2">
                <div class="bg-slate-800/70 border border-slate-700/60 text-slate-200 p-3 rounded-2xl rounded-tl-none leading-relaxed shadow-md">
                    ${formatMarkdown(text)}
                </div>
                ${renderProductCards(products)}
            </div>
        `;
        aiChatMessages.appendChild(wrapper);
        aiChatMessages.scrollTop = aiChatMessages.scrollHeight;
    }

    function appendTypingIndicator() {
        const wrapper = document.createElement('div');
        wrapper.className = 'flex items-start gap-2.5';
        wrapper.innerHTML = `
            <div class="w-7 h-7 rounded-full bg-cyan-500/20 border border-cyan-400/50 flex items-center justify-center text-xs shrink-0 mt-0.5">🤖</div>
            <div class="bg-slate-800/60 border border-slate-700/50 text-slate-300 px-3.5 py-2.5 rounded-2xl rounded-tl-none flex items-center gap-1.5 text-xs">
                <span class="w-1.5 h-1.5 bg-cyan-400 rounded-full animate-bounce"></span>
                <span class="w-1.5 h-1.5 bg-cyan-400 rounded-full animate-bounce [animation-delay:0.2s]"></span>
                <span class="w-1.5 h-1.5 bg-cyan-400 rounded-full animate-bounce [animation-delay:0.4s]"></span>
                <span class="text-[11px] text-slate-400 ml-1">ZenQ AI sedang mengetik...</span>
            </div>
        `;
        aiChatMessages.appendChild(wrapper);
        aiChatMessages.scrollTop = aiChatMessages.scrollHeight;
        return wrapper;
    }
</script>

