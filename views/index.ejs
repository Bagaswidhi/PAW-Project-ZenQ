<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <!-- Tailwind CSS via CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen flex flex-col justify-between">

    <!-- Navbar -->
    <nav class="bg-slate-800/80 backdrop-blur-md border-b border-slate-700 sticky top-0 z-50 px-6 py-4 flex justify-between items-center">
        <a href="/" class="text-xl font-bold text-cyan-400 flex items-center gap-2">
            <span>💻</span> ZenQ Store
        </a>
        <div class="flex items-center space-x-6 text-sm font-medium">
            <a href="/" class="text-cyan-400 hover:text-cyan-300 transition">Beranda</a>
            <a href="/api/status" target="_blank" class="text-slate-300 hover:text-cyan-400 transition">API Status</a>
            <a href="/api/produk" target="_blank" class="text-slate-300 hover:text-cyan-400 transition">API Produk</a>
        </div>
    </nav>

    <!-- Header Section -->
    <header class="max-w-6xl mx-auto px-6 py-12 text-center">
        <span class="bg-cyan-500/10 text-cyan-400 text-xs font-semibold px-3 py-1 rounded-full uppercase tracking-wider border border-cyan-500/20">
            Integrasi Express.js & EJS
        </span>
        <h1 class="text-4xl md:text-5xl font-extrabold text-white mt-4 mb-4 tracking-tight">
            TOKO KOMPUTER, TEMAN PILIH LAPTOP
        </h1>
        <p class="text-slate-400 max-w-2xl mx-auto text-base md:text-lg">
            Cari Laptop Kuliah Sesuai Budget Tanpa Bingung Spesifikasi. Tanyakan langsung ke ZenQ AI Assistant untuk rekomendasi instan.
        </p>
    </header>

    <!-- Main Content -->
    <main class="max-w-6xl mx-auto px-6 pb-16 flex-grow w-full space-y-8">

        <!-- Bagian Judul, Pencarian, Tombol Tambah, dan Filter Kategori -->
        <section class="border-b border-slate-700/60 pb-6 space-y-4">
            <div class="flex flex-col md:flex-row justify-between items-center gap-4">
                <h2 class="text-2xl font-bold text-slate-100 border-l-4 border-cyan-400 pl-3 w-full md:w-auto">
                    Katalog Laptop Pilihan
                </h2>

                <div class="flex flex-col sm:flex-row w-full md:w-auto gap-3 items-center">
                    <!-- Form Pencarian -->
                    <form action="/" method="GET" class="flex w-full sm:w-auto gap-2">
                        <% if (typeof currentKategori !== 'undefined' && currentKategori && currentKategori !== 'Semua') { %>
                            <input type="hidden" name="kategori" value="<%= currentKategori %>">
                        <% } %>
                        <input
                            type="text"
                            name="search"
                            value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>"
                            placeholder="Cari nama, prosesor..."
                            class="w-full sm:w-56 bg-slate-800 border border-slate-700 rounded-lg p-2 text-white focus:border-cyan-400 focus:outline-none text-sm"
                        >
                        <button type="submit" class="bg-slate-700 hover:bg-slate-600 text-white font-bold py-2 px-4 rounded-lg text-sm transition">
                            Cari
                        </button>

                        <!-- Tombol Reset Pencarian -->
                        <% if (typeof searchQuery !== 'undefined' && searchQuery) { %>
                            <a
                                href="/<%= typeof currentKategori !== 'undefined' && currentKategori && currentKategori !== 'Semua' ? '?kategori=' + encodeURIComponent(currentKategori) : '' %>"
                                class="bg-rose-500/20 text-rose-400 hover:bg-rose-500 hover:text-white font-bold py-2 px-3 rounded-lg text-sm transition flex items-center"
                                title="Reset Pencarian"
                            >✕</a>
                        <% } %>
                    </form>

                    <!-- Tombol Tambah Produk -->
                    <button
                        onclick="openAddModal()"
                        class="w-full sm:w-auto bg-cyan-500 hover:bg-cyan-600 text-slate-950 font-bold py-2 px-6 rounded-lg text-sm transition shadow-lg shadow-cyan-500/20 flex items-center justify-center gap-2"
                    >
                        ➕ Tambah
                    </button>
                </div>
            </div>

            <!-- Filter Kategori (Pills) -->
            <div class="flex flex-wrap gap-2 items-center pt-2">
                <span class="text-xs text-slate-400 font-semibold uppercase tracking-wider mr-1">Kategori:</span>
                <% const categories = ['Semua', 'Laptop Kuliah', 'Laptop Editing', 'Laptop Gaming']; %>
                <% categories.forEach(cat => { %>
                    <% const isActive = (typeof currentKategori !== 'undefined' ? currentKategori : 'Semua') === cat; %>
                    <a
                        href="/?kategori=<%= encodeURIComponent(cat) %><%= typeof searchQuery !== 'undefined' && searchQuery ? '&search=' + encodeURIComponent(searchQuery) : '' %>"
                        class="text-xs px-3.5 py-1.5 rounded-full font-medium transition <%= isActive ? 'bg-cyan-500 text-slate-950 font-bold shadow-md shadow-cyan-500/20' : 'bg-slate-800 text-slate-300 hover:bg-slate-700 hover:text-white border border-slate-700/60' %>"
                    >
                        <%= cat %>
                    </a>
                <% }); %>
            </div>
        </section>

        <!-- Daftar Katalog Produk (Read, Update, Delete) -->
        <section>
            <% if (products.length === 0) { %>
                <div class="bg-slate-800/60 border border-slate-700/60 rounded-xl p-10 text-center space-y-3">
                    <p class="text-slate-300 font-semibold text-base">Tidak ada laptop yang sesuai dengan filter pencarian.</p>
                    <a href="/" class="inline-block text-xs bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-bold px-4 py-2 rounded-lg transition">
                        Tampilkan Semua Produk
                    </a>
                </div>
            <% } else { %>
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                    <% products.forEach(product => { %>
                        <div class="bg-slate-800/60 border border-slate-700/60 rounded-xl p-5 flex flex-col justify-between hover:border-cyan-500/50 transition shadow-lg">
                            <div>
                                <div class="bg-slate-700/50 rounded-lg h-28 flex items-center justify-center text-slate-300 mb-3 font-bold text-center p-2 text-sm">
                                    <%= product.nama %>
                                </div>
                                <span class="text-xs font-semibold text-cyan-400 bg-cyan-950 px-2 py-0.5 rounded">
                                    <%= product.kategori %>
                                </span>
                                <h3 class="font-bold text-base text-white mt-2 mb-1"><%= product.nama %></h3>
                                <p class="text-xs text-slate-400 mb-2">
                                    <%= product.prosesor %> • <%= product.ram %> • <%= product.storage %>
                                </p>
                                <p class="text-xs text-slate-300 mb-3 line-clamp-2"><%= product.deskripsi %></p>
                            </div>

                            <div>
                                <div class="flex items-center justify-between mb-2 text-xs text-slate-400">
                                    <span>⭐ <%= product.rating %> (<%= product.terjual %>+ Terjual)</span>
                                    <span class="text-emerald-400 font-medium">Stok: <%= product.stok %></span>
                                </div>

                                <div class="text-cyan-400 font-extrabold text-base mb-3">
                                    Rp <%= Number(product.harga).toLocaleString('id-ID') %>
                                </div>

                                <!-- Tombol Detail -->
                                <a href="/produk/<%= product.id %>" class="block w-full bg-cyan-500 hover:bg-cyan-600 text-slate-950 font-bold py-2 rounded-lg text-xs text-center transition mb-2">
                                    Detail Produk
                                </a>

                                <!-- Tombol Edit & Hapus -->
                                <div class="flex gap-2">
                                    <button
                                        onclick="openEditModal('<%= product.id %>', '<%= product.nama %>', '<%= product.kategori %>', '<%= product.prosesor %>', '<%= product.ram %>', '<%= product.storage %>', '<%= product.harga %>', '<%= product.stok %>', '<%= product.rating %>', '<%= product.terjual %>', `<%= product.deskripsi %>`)"
                                        class="flex-1 bg-amber-500 hover:bg-amber-600 text-slate-950 font-bold py-1.5 rounded text-xs transition"
                                    >
                                        Edit
                                    </button>
                                    <form action="/produk/delete/<%= product.id %>" method="POST" class="flex-1" onsubmit="return confirm('Apakah Anda yakin ingin menghapus produk ini?')">
                                        <button type="submit" class="w-full bg-rose-500 hover:bg-rose-600 text-white font-bold py-1.5 rounded text-xs transition">
                                            Hapus
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                </div>
            <% } %>
        </section>

    </main>

    <!-- Modal Tambah Produk -->
    <div id="addModal" class="hidden fixed inset-0 bg-slate-950/80 backdrop-blur flex items-center justify-center p-4 z-50">
        <div class="bg-slate-800 border border-slate-700 rounded-xl p-6 max-w-2xl w-full">
            <h3 class="text-xl font-bold text-cyan-400 mb-4 border-b border-slate-700 pb-3">➕ Tambah Produk Baru</h3>
            <form action="/produk/add" method="POST" class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
                <input type="text" name="nama" placeholder="Nama Produk" required class="bg-slate-900 border border-slate-700 rounded-lg p-2.5 text-white focus:border-cyan-400 focus:outline-none">
                <input type="text" name="kategori" placeholder="Kategori (mis: Laptop Kuliah)" required class="bg-slate-900 border border-slate-700 rounded-lg p-2.5 text-white focus:border-cyan-400 focus:outline-none">
                <input type="text" name="prosesor" placeholder="Prosesor (Mis: Intel i5)" required class="bg-slate-900 border border-slate-700 rounded-lg p-2.5 text-white focus:border-cyan-400 focus:outline-none">
                <input type="text" name="ram" placeholder="RAM (mis: 8GB)" required class="bg-slate-900 border border-slate-700 rounded-lg p-2.5 text-white focus:border-cyan-400 focus:outline-none">
                <input type="text" name="storage" placeholder="Storage (Mis: 512GB SSD)" required class="bg-slate-900 border border-slate-700 rounded-lg p-2.5 text-white focus:border-cyan-400 focus:outline-none">
                <input type="number" name="harga" placeholder="Harga (Rp)" required class="bg-slate-900 border border-slate-700 rounded-lg p-2.5 text-white focus:border-cyan-400 focus:outline-none">
                <input type="number" name="stok" placeholder="Stok" required class="bg-slate-900 border border-slate-700 rounded-lg p-2.5 text-white focus:border-cyan-400 focus:outline-none">
                <div class="grid grid-cols-2 gap-4">
                    <input type="number" step="0.1" name="rating" placeholder="Rating (Default 4.5)" class="bg-slate-900 border border-slate-700 rounded-lg p-2.5 text-white focus:border-cyan-400 focus:outline-none">
                    <input type="number" name="terjual" placeholder="Terjual (Default 0)" class="bg-slate-900 border border-slate-700 rounded-lg p-2.5 text-white focus:border-cyan-400 focus:outline-none">
                </div>
                <textarea name="deskripsi" placeholder="Deskripsi Singkat" class="bg-slate-900 border border-slate-700 rounded-lg p-2.5 text-white focus:border-cyan-400 focus:outline-none md:col-span-2 h-20"></textarea>

                <div class="md:col-span-2 flex justify-end gap-3 mt-4 border-t border-slate-700 pt-4">
                    <button type="button" onclick="closeAddModal()" class="px-5 py-2.5 bg-slate-700 hover:bg-slate-600 text-slate-200 rounded-lg font-bold transition">Batal</button>
                    <button type="submit" class="px-5 py-2.5 bg-cyan-500 hover:bg-cyan-600 text-slate-950 rounded-lg font-bold transition">Simpan Produk</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Modal Edit Produk -->
    <div id="editModal" class="hidden fixed inset-0 bg-slate-950/80 backdrop-blur flex items-center justify-center p-4 z-50">
        <div class="bg-slate-800 border border-slate-700 rounded-xl p-6 max-w-2xl w-full">
            <h3 class="text-xl font-bold text-amber-400 mb-4 border-b border-slate-700 pb-3">✏️ Edit Data Produk</h3>
            <form id="editForm" method="POST" class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
                <input type="text" id="editNama" name="nama" required class="bg-slate-900 border border-slate-700 rounded-lg p-2.5 text-white">
                <input type="text" id="editKategori" name="kategori" required class="bg-slate-900 border border-slate-700 rounded-lg p-2.5 text-white">
                <input type="text" id="editProsesor" name="prosesor" required class="bg-slate-900 border border-slate-700 rounded-lg p-2.5 text-white">
                <input type="text" id="editRam" name="ram" required class="bg-slate-900 border border-slate-700 rounded-lg p-2.5 text-white">
                <input type="text" id="editStorage" name="storage" required class="bg-slate-900 border border-slate-700 rounded-lg p-2.5 text-white">
                <input type="number" id="editHarga" name="harga" required class="bg-slate-900 border border-slate-700 rounded-lg p-2.5 text-white">
                <input type="number" id="editStok" name="stok" required class="bg-slate-900 border border-slate-700 rounded-lg p-2.5 text-white">
                <div class="grid grid-cols-2 gap-4">
                    <input type="number" step="0.1" id="editRating" name="rating" class="bg-slate-900 border border-slate-700 rounded-lg p-2.5 text-white">
                    <input type="number" id="editTerjual" name="terjual" class="bg-slate-900 border border-slate-700 rounded-lg p-2.5 text-white">
                </div>
                <textarea id="editDeskripsi" name="deskripsi" class="bg-slate-900 border border-slate-700 rounded-lg p-2.5 text-white md:col-span-2 h-20"></textarea>

                <div class="md:col-span-2 flex justify-end gap-3 mt-4 border-t border-slate-700 pt-4">
                    <button type="button" onclick="closeEditModal()" class="px-5 py-2.5 bg-slate-700 hover:bg-slate-600 text-slate-200 rounded-lg font-bold transition">Batal</button>
                    <button type="submit" class="px-5 py-2.5 bg-amber-500 hover:bg-amber-600 text-slate-950 rounded-lg font-bold transition">Simpan Perubahan</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Script Modal CRUD -->
    <script>
        function openAddModal() {
            document.getElementById('addModal').classList.remove('hidden');
        }

        function closeAddModal() {
            document.getElementById('addModal').classList.add('hidden');
        }

        function openEditModal(id, nama, kategori, prosesor, ram, storage, harga, stok, rating, terjual, deskripsi) {
            document.getElementById('editForm').action = '/produk/edit/' + id;
            document.getElementById('editNama').value = nama;
            document.getElementById('editKategori').value = kategori;
            document.getElementById('editProsesor').value = prosesor;
            document.getElementById('editRam').value = ram;
            document.getElementById('editStorage').value = storage;
            document.getElementById('editHarga').value = harga;
            document.getElementById('editStok').value = stok;
            document.getElementById('editRating').value = rating;
            document.getElementById('editTerjual').value = terjual;
            document.getElementById('editDeskripsi').value = deskripsi;
            document.getElementById('editModal').classList.remove('hidden');
        }

        function closeEditModal() {
            document.getElementById('editModal').classList.add('hidden');
        }
    </script>

    <!-- FLOATING ZENQ AI CHATBOT WIDGET -->
    <div id="aiChatWrapper" class="fixed bottom-6 right-6 z-50 flex flex-col items-end">
        <!-- Box Chat -->
        <div id="aiChatBox" class="hidden mb-3 w-[calc(100vw-2rem)] sm:w-96 h-[520px] max-h-[80vh] bg-slate-900/95 border border-cyan-500/40 rounded-2xl shadow-2xl backdrop-blur-xl flex flex-col overflow-hidden transition-all duration-300">
            <!-- Header Chat -->
            <div class="bg-gradient-to-r from-slate-900 via-slate-800 to-slate-900 border-b border-slate-700/80 p-3.5 flex items-center justify-between">
                <div class="flex items-center gap-2.5">
                    <div class="relative w-9 h-9 rounded-full bg-cyan-500/20 border border-cyan-400/50 flex items-center justify-center text-lg">
                        🤖
                        <span class="absolute bottom-0 right-0 w-2.5 h-2.5 bg-emerald-400 border-2 border-slate-900 rounded-full"></span>
                    </div>
                    <div>
                        <h4 class="font-bold text-sm text-white">ZenQ AI Assistant</h4>
                        <p class="text-[11px] text-cyan-400 flex items-center gap-1">
                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span> Online • Rekomendasi Laptop
                        </p>
                    </div>
                </div>
                <button type="button" onclick="toggleChat()" class="text-slate-400 hover:text-white p-1.5 rounded-lg text-sm font-bold" title="Tutup Chat">
                    ✕
                </button>
            </div>

            <!-- Area Pesan -->
            <div id="aiChatMessages" class="flex-1 p-4 overflow-y-auto space-y-3 text-xs leading-relaxed">
                <div class="flex items-start gap-2.5">
                    <div class="w-7 h-7 rounded-full bg-cyan-500/20 border border-cyan-400/50 flex items-center justify-center text-xs shrink-0 mt-0.5">🤖</div>
                    <div class="bg-slate-800/70 border border-slate-700/60 text-slate-200 p-3 rounded-2xl rounded-tl-none max-w-[85%] space-y-2">
                        <p>Halo! 👋 Tanyakan apapun tentang spesifikasi, harga, atau rekomendasi laptop di ZenQ Store.</p>
                    </div>
                </div>
            </div>

            <!-- Form Input Chat -->
            <form id="aiChatForm" onsubmit="handleSendChat(event)" class="p-3 bg-slate-900/90 border-t border-slate-700/80 flex gap-2 items-center">
                <input type="text" id="aiChatInput" placeholder="Tanyakan seputar laptop ZenQ..." autocomplete="off" required class="flex-1 bg-slate-800 border border-slate-700 text-white text-xs rounded-xl px-3.5 py-2.5 focus:border-cyan-400 focus:outline-none">
                <button type="submit" id="aiChatSubmitBtn" class="bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-bold px-4 py-2.5 rounded-xl text-xs transition flex items-center justify-center shrink-0">
                    Kirim
                </button>
            </form>
        </div>

        <!-- Tombol Pemicu Floating Action Button -->
        <button type="button" id="aiChatToggleBtn" onclick="toggleChat()" class="group relative flex items-center gap-2.5 bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-slate-950 font-bold px-4 py-3 rounded-full shadow-xl shadow-cyan-500/25 transition-all transform hover:scale-105 active:scale-95">
            <span class="text-xl">🤖</span>
            <span class="text-xs font-extrabold tracking-wide text-slate-950 hidden sm:inline">Tanya ZenQ AI</span>
        </button>
    </div>

    <!-- Script Logika Chatbot -->
    <script>
        const aiChatBox = document.getElementById('aiChatBox');
        const aiChatMessages = document.getElementById('aiChatMessages');
        const aiChatInput = document.getElementById('aiChatInput');
        const aiChatSubmitBtn = document.getElementById('aiChatSubmitBtn');

        function toggleChat() {
            aiChatBox.classList.toggle('hidden');
            if (!aiChatBox.classList.contains('hidden')) {
                setTimeout(() => aiChatInput.focus(), 150);
            }
        }

        function formatMarkdown(text) {
            let html = text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
            html = html.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
            html = html.replace(/^\*\s+(.+)$/gm, '<div class="flex items-start gap-1.5 my-0.5"><span class="text-cyan-400">•</span><span>$1</span></div>');
            html = html.replace(/\n/g, '<br>');
            return html;
        }

        async function handleSendChat(e) {
            e.preventDefault();
            const message = aiChatInput.value.trim();
            if (!message) return;

            appendUserMessage(message);
            aiChatInput.value = '';
            aiChatInput.disabled = true;
            aiChatSubmitBtn.disabled = true;

            const typingIndicator = appendTypingIndicator();

            try {
                const res = await fetch('/api/chat', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ message })
                });

                const result = await res.json();
                typingIndicator.remove();

                if (res.ok && result.success && result.data && result.data.reply) {
                    appendBotMessage(result.data.reply);
                } else {
                    const errMsg = (result && result.message) ? result.message : 'Maaf, gagal mendapatkan respons dari asisten AI.';
                    appendBotMessage(`⚠️ ${errMsg}`);
                }
            } catch (err) {
                typingIndicator.remove();
                appendBotMessage('⚠️ Terjadi gangguan koneksi ke server chatbot.');
            } finally {
                aiChatInput.disabled = false;
                aiChatSubmitBtn.disabled = false;
                aiChatInput.focus();
                aiChatMessages.scrollTop = aiChatMessages.scrollHeight;
            }
        }

        function appendUserMessage(text) {
            const wrapper = document.createElement('div');
            wrapper.className = 'flex justify-end';
            wrapper.innerHTML = `
                <div class="bg-gradient-to-r from-cyan-600 to-blue-600 text-white p-3 rounded-2xl rounded-tr-none max-w-[85%] shadow-md">
                    ${formatMarkdown(text)}
                </div>
            `;
            aiChatMessages.appendChild(wrapper);
            aiChatMessages.scrollTop = aiChatMessages.scrollHeight;
        }

        function appendBotMessage(text) {
            const wrapper = document.createElement('div');
            wrapper.className = 'flex items-start gap-2.5';
            wrapper.innerHTML = `
                <div class="w-7 h-7 rounded-full bg-cyan-500/20 border border-cyan-400/50 flex items-center justify-center text-xs shrink-0 mt-0.5">🤖</div>
                <div class="bg-slate-800/70 border border-slate-700/60 text-slate-200 p-3 rounded-2xl rounded-tl-none max-w-[85%] leading-relaxed shadow-md">
                    ${formatMarkdown(text)}
                </div>
            `;
            aiChatMessages.appendChild(wrapper);
            aiChatMessages.scrollTop = aiChatMessages.scrollHeight;
        }

        function appendTypingIndicator() {
            const wrapper = document.createElement('div');
            wrapper.className = 'flex items-start gap-2.5';
            wrapper.innerHTML = `
                <div class="w-7 h-7 rounded-full bg-cyan-500/20 border border-cyan-400/50 flex items-center justify-center text-xs shrink-0 mt-0.5">🤖</div>
                <div class="bg-slate-800/60 border border-slate-700/50 text-slate-300 px-3.5 py-2.5 rounded-2xl rounded-tl-none flex items-center gap-1.5 text-xs">
                    <span class="w-1.5 h-1.5 bg-cyan-400 rounded-full animate-bounce"></span>
                    <span class="w-1.5 h-1.5 bg-cyan-400 rounded-full animate-bounce [animation-delay:0.2s]"></span>
                    <span class="w-1.5 h-1.5 bg-cyan-400 rounded-full animate-bounce [animation-delay:0.4s]"></span>
                    <span class="text-[11px] text-slate-400 ml-1">ZenQ AI sedang mengetik...</span>
                </div>
            `;
            aiChatMessages.appendChild(wrapper);
            aiChatMessages.scrollTop = aiChatMessages.scrollHeight;
            return wrapper;
        }
    </script>

    <!-- Footer -->
    <footer class="bg-slate-800/50 border-t border-slate-700/50 py-6 text-center text-slate-400 text-sm mt-auto">
        <p>&copy; 2026 ZenQ Store — Proyek Pengembangan Aplikasi Web (Express.js, EJS, PostgreSQL & Gemini AI)</p>
    </footer>

</body>
</html>