<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <!-- Tailwind CSS via CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen font-sans flex flex-col justify-between">

    <!-- Navbar -->
    <nav class="bg-slate-800/80 backdrop-blur border-b border-slate-700 sticky top-0 z-50 px-6 py-4 flex justify-between items-center">
        <a href="/" class="text-xl font-bold text-cyan-400">ZenQ Store</a>
        <div class="flex space-x-6 text-sm font-medium">
            <a href="/" class="text-cyan-400 hover:text-cyan-300 transition">Beranda</a>
            <a href="/api/status" target="_blank" class="text-slate-300 hover:text-cyan-400 transition">API Status</a>
            <a href="/api/produk" target="_blank" class="text-slate-300 hover:text-cyan-400 transition">API Produk</a>
        </div>
    </nav>

    <!-- Header Section -->
    <header class="max-w-6xl mx-auto px-6 py-12 text-center">
        <span class="bg-cyan-500/10 text-cyan-400 text-xs font-semibold px-3 py-1 rounded-full uppercase tracking-wider border border-cyan-500/20">Integrasi Express.js & EJS</span>
        <h1 class="text-4xl md:text-5xl font-extrabold mt-4 mb-4 text-white">TOKO KOMPUTER, TEMAN PILIH LAPTOP</h1>
        <p class="text-slate-400 max-w-2xl mx-auto text-base md:text-lg">
            Cari Laptop Kuliah Sesuai Budget Tanpa Bingung Spesifikasi. Tanyakan langsung ke ZenQ AI Assistant untuk rekomendasi instan.
        </p>
    </header>

    <!-- Main Content -->
    <main class="max-w-6xl mx-auto px-6 pb-16 flex-grow w-full space-y-8">
        
<!-- Bagian Judul, Pencarian, dan Tombol Tambah -->
        <section class="flex flex-col md:flex-row justify-between items-center border-b border-slate-700/60 pb-6 gap-4">
            <h2 class="text-2xl font-bold text-slate-100 border-l-4 border-cyan-400 pl-3 w-full md:w-auto">Katalog Laptop Pilihan</h2>
            
            <div class="flex flex-col sm:flex-row w-full md:w-auto gap-3 items-center">
                
                <!-- Form Pencarian -->
                <form action="/" method="GET" class="flex w-full sm:w-auto gap-2">
                    <input type="text" name="search" value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>" placeholder="Cari nama, prosesor..." class="w-full sm:w-56 bg-slate-800 border border-slate-700 rounded-lg p-2 text-white focus:border-cyan-400 focus:outline-none text-sm">
                    <button type="submit" class="bg-slate-700 hover:bg-slate-600 text-white font-bold py-2 px-4 rounded-lg text-sm transition">Cari</button>
                    
                    <!-- Tombol Reset (Muncul jika sedang mencari sesuatu) -->
                    <% if (typeof searchQuery !== 'undefined' && searchQuery) { %>
                        <a href="/" class="bg-rose-500/20 text-rose-400 hover:bg-rose-500 hover:text-white font-bold py-2 px-3 rounded-lg text-sm transition flex items-center" title="Reset Pencarian">✕</a>
                    <% } %>
                </form>

                <!-- Tombol Tambah Produk -->
                <button onclick="openAddModal()" class="w-full sm:w-auto bg-cyan-500 hover:bg-cyan-600 text-slate-950 font-bold py-2 px-6 rounded-lg text-sm transition shadow-lg shadow-cyan-500/20 flex items-center justify-center gap-2">
                    ➕ Tambah
                </button>
            </div>
        </section>

        <!-- Daftar Katalog Produk (Read, Update, Delete) -->
        <section>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                <% products.forEach(product => { %>
                    <div class="bg-slate-800/60 border border-slate-700/60 rounded-xl p-5 flex flex-col justify-between hover:border-cyan-500/50 transition shadow-lg">
                        <div>
                            <div class="bg-slate-700/50 rounded-lg h-28 flex items-center justify-center text-slate-300 mb-3 font-bold text-center p-2 text-sm">
                                <%= product.nama %>
                            </div>
                            <span class="text-xs font-semibold text-cyan-400 bg-cyan-950 px-2 py-0.5 rounded"><%= product.kategori %></span>
                            <h3 class="font-bold text-base text-white mt-2 mb-1"><%= product.nama %></h3>
                            <p class="text-xs text-slate-400 mb-2"><%= product.prosesor %> • <%= product.ram %> • <%= product.storage %></p>
                            <p class="text-xs text-slate-300 mb-3 line-clamp-2"><%= product.deskripsi %></p>
                        </div>

                        <div>
                            <div class="flex items-center justify-between mb-2 text-xs text-slate-400">
                                <span>⭐ <%= product.rating %> (<%= product.terjual %>+ Terjual)</span>
                                <span class="text-emerald-400">Stok: <%= product.stok %></span>
                            </div>
                            <div class="text-cyan-400 font-extrabold text-base mb-3">
                                Rp <%= Number(product.harga).toLocaleString('id-ID') %>
                            </div>

                            <!-- Tombol Detail -->
                            <a href="/produk/<%= product.id %>" class="block w-full bg-cyan-500 hover:bg-cyan-600 text-slate-950 font-bold py-2 rounded-lg text-sm text-center transition mb-2">
                                Detail Produk
                            </a>

                            <!-- Tombol Edit & Hapus -->
                            <div class="flex gap-2">
                                <button onclick="openEditModal('<%= product.id %>', '<%= product.nama %>', '<%= product.kategori %>', '<%= product.prosesor %>', '<%= product.ram %>', '<%= product.storage %>', '<%= product.harga %>', '<%= product.stok %>', '<%= product.rating %>', '<%= product.terjual %>', '<%= product.deskripsi %>')" class="flex-1 bg-amber-500 hover:bg-amber-600 text-slate-950 font-bold py-1.5 rounded text-xs transition">
                                    Edit
                                </button>
                                <form action="/produk/delete/<%= product.id %>" method="POST" class="flex-1" onsubmit="return confirm('Apakah Anda yakin ingin menghapus produk ini?')">
                                    <button type="submit" class="w-full bg-rose-500 hover:bg-rose-600 text-white font-bold py-1.5 rounded text-xs transition">
                                        Hapus
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                <% }); %>
            </div>
        </section>
    </main>

    <!-- Modal Tambah Produk -->
    <div id="addModal" class="hidden fixed inset-0 bg-slate-950/80 backdrop-blur flex items-center justify-center p-4 z-50">
        <div class="bg-slate-800 border border-slate-700 rounded-xl p-6 max-w-2xl w-full">
            <h3 class="text-xl font-bold text-cyan-400 mb-4 border-b border-slate-700 pb-3">➕ Tambah Produk Baru</h3>
            <form action="/produk/add" method="POST" class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
                <input type="text" name="nama" placeholder="Nama Produk" required class="bg-slate-900 border border-slate-700 rounded-lg p-2.5 text-white focus:border-cyan-400 focus:outline-none">
                <input type="text" name="kategori" placeholder="Kategori (mis: Laptop Kuliah)" required class="bg-slate-900 border border-slate-700 rounded-lg p-2.5 text-white focus:border-cyan-400 focus:outline-none">
                <input type="text" name="prosesor" placeholder="Prosesor (mis: Intel i5)" required class="bg-slate-900 border border-slate-700 rounded-lg p-2.5 text-white focus:border-cyan-400 focus:outline-none">
                <input type="text" name="ram" placeholder="RAM (mis: 8GB)" required class="bg-slate-900 border border-slate-700 rounded-lg p-2.5 text-white focus:border-cyan-400 focus:outline-none">
                <input type="text" name="storage" placeholder="Storage (mis: 512GB SSD)" required class="bg-slate-900 border border-slate-700 rounded-lg p-2.5 text-white focus:border-cyan-400 focus:outline-none">
                <input type="number" name="harga" placeholder="Harga (Rp)" required class="bg-slate-900 border border-slate-700 rounded-lg p-2.5 text-white focus:border-cyan-400 focus:outline-none">
                <input type="number" name="stok" placeholder="Stok" required class="bg-slate-900 border border-slate-700 rounded-lg p-2.5 text-white focus:border-cyan-400 focus:outline-none">
                <div class="grid grid-cols-2 gap-4">
                    <input type="number" step="0.1" name="rating" placeholder="Rating (Default 4.5)" class="bg-slate-900 border border-slate-700 rounded-lg p-2.5 text-white focus:border-cyan-400 focus:outline-none">
                    <input type="number" name="terjual" placeholder="Terjual (Default 0)" class="bg-slate-900 border border-slate-700 rounded-lg p-2.5 text-white focus:border-cyan-400 focus:outline-none">
                </div>
                <textarea name="deskripsi" placeholder="Deskripsi Singkat" class="bg-slate-900 border border-slate-700 rounded-lg p-2.5 text-white md:col-span-2 focus:border-cyan-400 focus:outline-none h-20"></textarea>
                
                <div class="md:col-span-2 flex justify-end gap-3 mt-4 border-t border-slate-700 pt-4">
                    <button type="button" onclick="closeAddModal()" class="px-5 py-2.5 bg-slate-700 hover:bg-slate-600 text-slate-200 rounded-lg font-bold transition">Batal</button>
                    <button type="submit" class="px-5 py-2.5 bg-cyan-500 hover:bg-cyan-600 text-slate-950 rounded-lg font-bold transition">Simpan Produk</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Modal Edit Produk -->
    <div id="editModal" class="hidden fixed inset-0 bg-slate-950/80 backdrop-blur flex items-center justify-center p-4 z-50">
        <div class="bg-slate-800 border border-slate-700 rounded-xl p-6 max-w-2xl w-full">
            <h3 class="text-xl font-bold text-amber-400 mb-4 border-b border-slate-700 pb-3">✏️ Edit Data Produk</h3>
            <form id="editForm" method="POST" class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
                <input type="text" id="editNama" name="nama" required class="bg-slate-900 border border-slate-700 rounded-lg p-2.5 text-white">
                <input type="text" id="editKategori" name="kategori" required class="bg-slate-900 border border-slate-700 rounded-lg p-2.5 text-white">
                <input type="text" id="editProsesor" name="prosesor" required class="bg-slate-900 border border-slate-700 rounded-lg p-2.5 text-white">
                <input type="text" id="editRam" name="ram" required class="bg-slate-900 border border-slate-700 rounded-lg p-2.5 text-white">
                <input type="text" id="editStorage" name="storage" required class="bg-slate-900 border border-slate-700 rounded-lg p-2.5 text-white">
                <input type="number" id="editHarga" name="harga" required class="bg-slate-900 border border-slate-700 rounded-lg p-2.5 text-white">
                <input type="number" id="editStok" name="stok" required class="bg-slate-900 border border-slate-700 rounded-lg p-2.5 text-white">
                <div class="grid grid-cols-2 gap-4">
                    <input type="number" step="0.1" id="editRating" name="rating" class="bg-slate-900 border border-slate-700 rounded-lg p-2.5 text-white">
                    <input type="number" id="editTerjual" name="terjual" class="bg-slate-900 border border-slate-700 rounded-lg p-2.5 text-white">
                </div>
                <textarea id="editDeskripsi" name="deskripsi" class="bg-slate-900 border border-slate-700 rounded-lg p-2.5 text-white md:col-span-2 h-20"></textarea>
                
                <div class="md:col-span-2 flex justify-end gap-3 mt-4 border-t border-slate-700 pt-4">
                    <button type="button" onclick="closeEditModal()" class="px-5 py-2.5 bg-slate-700 hover:bg-slate-600 text-slate-200 rounded-lg font-bold transition">Batal</button>
                    <button type="submit" class="px-5 py-2.5 bg-amber-500 hover:bg-amber-600 text-slate-950 rounded-lg font-bold transition">Simpan Perubahan</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        // Fungsi untuk Modal Tambah Produk
        function openAddModal() {
            document.getElementById('addModal').classList.remove('hidden');
        }

        function closeAddModal() {
            document.getElementById('addModal').classList.add('hidden');
        }

        // Fungsi untuk Modal Edit Produk
        function openEditModal(id, nama, kategori, prosesor, ram, storage, harga, stok, rating, terjual, deskripsi) {
            document.getElementById('editForm').action = '/produk/edit/' + id;
            document.getElementById('editNama').value = nama;
            document.getElementById('editKategori').value = kategori;
            document.getElementById('editProsesor').value = prosesor;
            document.getElementById('editRam').value = ram;
            document.getElementById('editStorage').value = storage;
            document.getElementById('editHarga').value = harga;
            document.getElementById('editStok').value = stok;
            document.getElementById('editRating').value = rating;
            document.getElementById('editTerjual').value = terjual;
            document.getElementById('editDeskripsi').value = deskripsi;
            document.getElementById('editModal').classList.remove('hidden');
        }

        function closeEditModal() {
            document.getElementById('editModal').classList.add('hidden');
        }
    </script>

    <!-- Footer -->
    <footer class="bg-slate-800/50 border-t border-slate-700/50 py-6 text-center text-slate-400 text-sm mt-auto">
        <p>&copy; 2026 ZenQ Store — Tugas Praktikum PPAW Week 7 (MVC, REST API & Logger)</p>
    </footer>

</body>
</html>