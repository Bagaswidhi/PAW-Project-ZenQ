<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <!-- Tailwind CSS via CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-slate-900 text-slate-100 min-h-screen font-sans flex flex-col justify-between">

    <!-- Navbar -->
    <nav
        class="bg-slate-800/80 backdrop-blur border-b border-slate-700 sticky top-0 z-50 px-6 py-4 flex justify-between items-center">
        <div class="text-xl font-bold text-cyan-400">ZenQ Store</div>
        <div class="flex space-x-6 text-sm font-medium">
            <a href="/" class="text-cyan-400 hover:text-cyan-300 transition">Beranda</a>
            <a href="/api/status" target="_blank" class="text-slate-300 hover:text-cyan-400 transition">API Status</a>
            <a href="/api/produk" target="_blank" class="text-slate-300 hover:text-cyan-400 transition">API Produk</a>
        </div>
    </nav>

    <!-- Hero Section -->
    <header class="max-w-6xl mx-auto px-6 py-12 text-center">
        <span
            class="bg-cyan-500/10 text-cyan-400 text-xs font-semibold px-3 py-1 rounded-full uppercase tracking-wider border border-cyan-500/20">Integrasi
            Express.js & EJS</span>
        <h1 class="text-4xl md:text-5xl font-extrabold mt-4 mb-4 text-white">TOKO KOMPUTER, TEMAN PILIH LAPTOP</h1>
        <p class="text-slate-400 max-w-2xl mx-auto text-base md:text-lg">
            Cari Laptop Kuliah Sesuai Budget Tanpa Bingung Spesifikasi. Tanyakan langsung ke ZenQ AI Assistant untuk
            rekomendasi instan.
        </p>
    </header>

    <!-- Product Grid (Ditarik dari Model) -->
    <main class="max-w-6xl mx-auto px-6 pb-16 flex-grow w-full">
        <h2 class="text-2xl font-bold mb-6 text-slate-100 border-l-4 border-cyan-400 pl-3">Katalog Laptop Pilihan</h2>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            <% products.forEach(product=> { %>
                <div
                    class="bg-slate-800/60 border border-slate-700/60 rounded-xl p-5 flex flex-col justify-between hover:border-cyan-500/50 transition shadow-lg">
                    <div>
                        <div
                            class="bg-slate-700/50 rounded-lg h-36 flex items-center justify-center text-slate-300 mb-4 font-bold text-center p-2">
                            <%= product.nama %>
                        </div>
                        <span class="text-xs font-semibold text-cyan-400 bg-cyan-950 px-2 py-0.5 rounded">
                            <%= product.kategori %>
                        </span>
                        <h3 class="font-bold text-lg text-white mt-2 mb-1">
                            <%= product.nama %>
                        </h3>
                        <p class="text-xs text-slate-400 mb-3">
                            <%= product.prosesor %> • <%= product.ram %> • <%= product.storage %>
                        </p>
                        <p class="text-sm text-slate-300 mb-4 line-clamp-2">
                            <%= product.deskripsi %>
                        </p>
                    </div>

                    <div>
                        <div class="flex items-center justify-between mb-3 text-xs text-slate-400">
                            <span>⭐ <%= product.rating %> (<%= product.terjual %>+ Terjual)</span>
                            <span class="text-emerald-400">Stok: <%= product.stok %></span>
                        </div>
                        <div class="text-cyan-400 font-extrabold text-lg mb-3">
                            Rp <%= product.harga.toLocaleString('id-ID') %>
                        </div>
                            <a href="/produk/<%= product.id %>"
                                class="block text-center w-full bg-cyan-500 hover:bg-cyan-600 text-slate-950 font-bold py-2 rounded-lg text-sm transition">
                                Detail Produk
                        </a>
                    </div>
                </div>
                <% }); %>
        </div>
    </main>

    <!-- Footer -->
    <footer class="bg-slate-800/50 border-t border-slate-700/50 py-6 text-center text-slate-400 text-sm">
        <p>&copy; 2026 ZenQ Store — Tugas Praktikum PPAW Week 7 (MVC, REST API & Logger)</p>
    </footer>

</body>

</html>